{
  "template_id": "amex_us_card",
  "institution_id": "amex_us",
  "label": "American Express US card statement (Platinum, Bonvoy Brilliant, Green)",
  "version": "2.0.0",
  "match_all": [
    "American Express",
    "Closing\\s+Date\\s+\\d{2}/\\d{2}/\\d{2}",
    "Total\\s+New\\s+Charges",
    "About\\s+Trailing\\s+Interest"
  ],
  "match_none": [
    "High\\s+Yield\\s+Savings",
    "(?-i:STATEMENT\\s+PERIOD)"
  ],
  "default_currency": "USD",
  "date": {
    "format": "auto",
    "dayfirst": false,
    "year_from_statement": true
  },
  "statement_date": "Closing\\s+Date\\s+(\\d{2}/\\d{2}/\\d{2})",
  "period": "",
  "body_start": "Indicates\\s+posting\\s+date",
  "body_end": "About\\s+Trailing\\s+Interest|Fees\\s+and\\s+Interest\\s+Totals\\s+Year-to-Date|Interest\\s+Charge\\s+Calculation",
  "sections": [
    {
      "name": "card",
      "start": "",
      "end": "",
      "currency": "USD",
      "account_hint": "AMEX US card",
      "columns": {
        "mode": "fractions",
        "header": "",
        "anchors": {},
        "fractions": [
          [
            "date",
            0.0,
            0.14
          ],
          [
            "description",
            0.14,
            0.655
          ],
          [
            "fx",
            0.655,
            0.79
          ],
          [
            "amount",
            0.79,
            1.0
          ]
        ]
      },
      "amount": {
        "mode": "signed",
        "column": "amount",
        "invert": true
      },
      "description_column": "description",
      "exclude": [
        "^\\d{1,2}/\\d{1,2}/\\d{2}\\*?\\s+Total\\s+",
        "Spend Amount$",
        "^(Foreign|Amount|Detail|Card Ending|Summary)\\b",
        "^p\\. \\d+/\\d+$",
        "^Continued on ",
        "Account Ending\\d",
        "^Closing Date",
        "^Total New Charges",
        "^Pay In Full",
        "^New Charges$",
        "^(Payments|Credits|Total Payments and Credits|Fees|Interest Charged)\\b",
        "Pay Over Time and/or Cash Advance activity",
        "^YIXIANG ZHOU$",
        "^Total (Fees|Interest Charged) for this Period",
        "^TRANSACTION PROCESSED BY AMERICAN EXPRESS"
      ],
      "balances": [
        {
          "pattern": "^Previous\\s+Balance",
          "kind": "opening",
          "scope": "document",
          "token_index": 0,
          "negate": true
        },
        {
          "pattern": "^New\\s+Balance",
          "kind": "closing",
          "scope": "document",
          "token_index": 0,
          "negate": true
        }
      ],
      "stop_at": [
        "About\\s+Trailing\\s+Interest",
        "Fees\\s+and\\s+Interest\\s+Totals\\s+Year-to-Date"
      ],
      "markers": [
        {
          "match": "^Card Ending\\s*\\d-(\\d+)$",
          "keys": [
            "card.last4"
          ]
        }
      ],
      "row_start": "\\d{1,2}/\\d{1,2}/\\d{2}[*\\s]",
      "detail": [
        {
          "match": "^([A-Z][A-Z .'-]+ [A-Z0-9]{2} [A-Z])$",
          "keys": [
            "travel.itinerary"
          ],
          "column": "description",
          "on": "detail"
        },
        {
          "match": "^([A-Z][A-Z &'/.-]{3,})$",
          "keys": [
            "merchant.category"
          ],
          "column": "description",
          "on": "detail"
        }
      ]
    }
  ],
  "source": "builtin"
}
