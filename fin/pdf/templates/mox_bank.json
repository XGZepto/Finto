{
  "template_id": "mox_bank",
  "institution_id": "mox",
  "label": "Mox Bank monthly statement (multi-currency)",
  "version": "1.0.0",
  "match_all": [
    "Mox Bank statement",
    "Activities"
  ],
  "default_currency": "HKD",
  "date": {
    "format": "auto",
    "dayfirst": true,
    "year_from_statement": true
  },
  "statement_date": "Statement date:\\s*(\\d{1,2}\\s+\\w+\\s+\\d{4})",
  "period": "Statement period:\\s*(\\d{1,2}\\s+\\w+\\s+\\d{4})\\s*-\\s*(\\d{1,2}\\s+\\w+\\s+\\d{4})",
  "body_start": "^Activities",
  "sections": [
    {
      "name": "hkd",
      "start": "HKD Mox Account",
      "end": "JPY Mox Account|Important notice",
      "currency": "HKD",
      "account_hint": "HKD Mox Account",
      "columns": {
        "mode": "anchors",
        "header": "^Activity\\b",
        "anchors": {
          "date": "^Activity$|^Activity date",
          "settlement": "^Settlement",
          "description": "(?-i:Description)",
          "fx": "(?-i:Corresponding)",
          "amount": "(?-i:^Amount)"
        }
      },
      "amount": {
        "mode": "signed",
        "column": "amount",
        "invert": false
      },
      "exclude": [
        "^Page \\d+ of \\d+$",
        "\u4ea4\u6613\u2f47\u671f",
        "\u5c0d\u61c9\u8ca8\u5e63\u2fa6\u984d",
        "^Activities"
      ],
      "balances": [
        {
          "pattern": "Opening balance",
          "kind": "opening",
          "column": "amount"
        },
        {
          "pattern": "Closing balance",
          "kind": "closing",
          "column": "amount"
        }
      ],
      "description_column": "description",
      "settlement_column": "settlement",
      "wraps": true
    },
    {
      "name": "jpy",
      "start": "JPY Mox Account",
      "end": "Important notice|How to earn",
      "currency": "JPY",
      "account_hint": "JPY Mox Account",
      "columns": {
        "mode": "anchors",
        "header": "^Activity\\b",
        "anchors": {
          "date": "^Activity$|^Activity date",
          "settlement": "^Settlement",
          "description": "(?-i:Description)",
          "fx": "(?-i:Corresponding)",
          "amount": "(?-i:^Amount)"
        }
      },
      "amount": {
        "mode": "signed",
        "column": "amount",
        "invert": false
      },
      "exclude": [
        "^Page \\d+ of \\d+$",
        "\u4ea4\u6613\u2f47\u671f",
        "\u5c0d\u61c9\u8ca8\u5e63\u2fa6\u984d"
      ],
      "balances": [
        {
          "pattern": "Opening balance",
          "kind": "opening",
          "column": "amount"
        },
        {
          "pattern": "Closing balance",
          "kind": "closing",
          "column": "amount"
        }
      ],
      "description_column": "description",
      "settlement_column": "settlement",
      "wraps": true
    }
  ],
  "source": "builtin"
}
