{
  "template_id": "mox_credit",
  "institution_id": "mox",
  "label": "Mox Credit card statement",
  "version": "1.0.0",
  "match_all": [
    "Mox Credit statement",
    "Transaction details"
  ],
  "default_currency": "HKD",
  "date": {
    "format": "auto",
    "dayfirst": true,
    "year_from_statement": true
  },
  "period": "(\\d{1,2}\\s+\\w{3,9}\\s+\\d{4})\\s*-\\s*(\\d{1,2}\\s+\\w{3,9}\\s+\\d{4})",
  "body_start": "Transaction details",
  "sections": [
    {
      "name": "card",
      "start": "Transaction details",
      "end": "Repayment calculator|Rate summary|Important notice",
      "currency": "HKD",
      "account_hint": "Mox Credit",
      "columns": {
        "mode": "anchors",
        "header": "^Activity\\b",
        "anchors": {
          "date": "^Activity$|^Activity date",
          "settlement": "^Settlement",
          "description": "(?-i:Description)",
          "fx": "(?-i:Foreign)",
          "amount": "(?-i:^Amount)"
        }
      },
      "amount": {
        "mode": "signed",
        "column": "amount",
        "invert": false
      },
      "description_column": "description",
      "settlement_column": "settlement",
      "exclude": [
        "^Page \\d+ of \\d+$",
        "\u4ea4\u6613\u2f47\u671f",
        "\u5916\u5e63\u2fa6\u984d",
        "\u2fa6\u984d \\(\u6e2f\u5e63\\)"
      ],
      "balances": [
        {
          "pattern": "Statement balance",
          "kind": "closing",
          "scope": "document",
          "line_offset": -1
        }
      ],
      "wraps": true
    }
  ],
  "source": "builtin"
}
